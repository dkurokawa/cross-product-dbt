[sqlfluff]
dialect = duckdb
templater = jinja
max_line_length = 100
# Models are linted as written (Jinja rendered with stand-ins for dbt), not as compiled.

[sqlfluff:indentation]
indented_joins = False
indented_using_on = True

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

# Stand-ins for dbt's context: ref/source/config/var come from sqlfluff's dbt builtins; the
# project's own macros (dbt/macros/portable.sql) are replaced by neutral one-line bodies,
# because the real ones dispatch on the adapter, which plain Jinja does not have.
[sqlfluff:templater:jinja:macros]
col = {% macro col(name) %}"{{ name }}"{% endmacro %}
to_utc_from_jst = {% macro to_utc_from_jst(expr) %}({{ expr }}){% endmacro %}
to_date_jst = {% macro to_date_jst(expr) %}cast({{ expr }} as date){% endmacro %}
parse_date_slash = {% macro parse_date_slash(expr) %}cast({{ expr }} as date){% endmacro %}
to_utc_timestamp = {% macro to_utc_timestamp(expr) %}cast({{ expr }} as timestamp){% endmacro %}
normalize_digits = {% macro normalize_digits(expr) %}replace({{ expr }}, ',', ''){% endmacro %}
to_int = {% macro to_int(expr) %}cast({{ expr }} as bigint){% endmacro %}
to_decimal = {% macro to_decimal(expr) %}cast({{ expr }} as numeric){% endmacro %}
to_str = {% macro to_str(expr) %}cast({{ expr }} as varchar){% endmacro %}
to_bigint = {% macro to_bigint(expr) %}cast({{ expr }} as bigint){% endmacro %}
to_numeric = {% macro to_numeric(expr) %}cast({{ expr }} as numeric){% endmacro %}
month_start = {% macro month_start(expr) %}cast(date_trunc('month', {{ expr }}) as date){% endmacro %}
month_end_date = {% macro month_end_date(expr) %}cast(date_trunc('month', {{ expr }}) as date){% endmacro %}
add_days = {% macro add_days(expr, n) %}cast({{ expr }} as date){% endmacro %}
mask_email_domain = {% macro mask_email_domain(expr) %}split_part({{ expr }}, '@', 2){% endmacro %}
mask_phone_last4 = {% macro mask_phone_last4(expr) %}right({{ expr }}, 4){% endmacro %}
mask_birth_year = {% macro mask_birth_year(expr) %}cast(extract(year from {{ expr }}) as bigint){% endmacro %}
mask_initial = {% macro mask_initial(expr) %}left({{ expr }}, 1) || '***'{% endmacro %}
list_to_text = {% macro list_to_text(expr) %}array_to_string({{ expr }}, ','){% endmacro %}
audit_events = {% macro audit_events(name) %}audit_{{ name }}{% endmacro %}
month_spine = {% macro month_spine(start_expr, end_expr) %}select cast({{ start_expr }} as date) as date_month, cast({{ end_expr }} as date) as end_month{% endmacro %}
row_hash = {% macro row_hash(columns) %}md5(concat({{ columns | join(', ') }})){% endmacro %}

# `source`, `name`, `value`, `file`, `partition_date`... are ordinary column names in every
# warehouse targeted here (none of them is reserved in DuckDB or BigQuery).
[sqlfluff:rules:references.keywords]
ignore_words = source,name,value,file,definition,status,reason,stage,product,dataset
